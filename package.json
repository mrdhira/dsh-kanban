{
  "name": "dsh-kanban",
  "version": "1.0.0",
  "private": true,
  "description": "A Kanban board for the DSH Web GUI: one SQLite task board with drag-and-drop, views and templates in its own sidebar panel, plus host tools, a skill and a CLI so agents and the human work the same cards.",
  "type": "module",
  "license": "MIT",
  "main": "lib/v1/host/index.js",
  "bin": {
    "dsh-kanban": "./bin/kanban.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/v1/host/index.js"
    },
    "./host": {
      "default": "./lib/v1/host/index.js"
    },
    "./client": {
      "default": "./lib/v1/client.js"
    },
    "./store": {
      "default": "./lib/v1/store/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "lib/**/*.d.ts",
    "src/**/*.ts",
    "src/**/*.cts",
    "types/**/*.d.ts",
    "bin/**/*.mjs",
    "build.mjs",
    "tsconfig.json",
    "tsconfig.dynamic.json",
    "tsconfig.test.json",
    "tsconfig.build.json",
    "scripts/**/*.mjs",
    "cordis.patch.yml",
    "README.md"
  ],
  "scripts": {
    "guard": "node scripts/guard.mjs",
    "build": "node build.mjs",
    "typecheck": "node scripts/typecheck.mjs",
    "test": "node scripts/guard.mjs --limit-mb 1024 -- node --max-old-space-size=384 --test --test-isolation=none --test-timeout=20000 --test-force-exit \"test/*.test.ts\"",
    "pretest": "npm run build"
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-api-remotes"
      ]
    }
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "^0.28.2",
    "jsdom": "^30.1.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^7.0.2"
  }
}
